<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.doctordefector.Lyrenne</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Lyrenne</name>
  <summary>Play YouTube Music on your desktop</summary>
  <developer id="io.github.doctordefector">
    <name>Doctordefector</name>
  </developer>
  <description>
    <p>
      Lyrenne is a native YouTube Music player for the desktop. It is not a browser wrapper: it has
      its own player, local database and sync layer.
    </p>
    <p>Sign in with your own account and it plays your real library:</p>
    <ul>
      <li>Two-way sync of liked songs, albums, artists and playlists</li>
      <li>Synced lyrics with romanization</li>
      <li>A 10-band equalizer, crossfade, playback speed and a sleep timer</li>
      <li>Downloads for offline listening</li>
      <li>Discord Rich Presence and Last.fm scrobbling</li>
      <li>Listen Together rooms with friends</li>
      <li>Media keys and desktop media controls through MPRIS</li>
    </ul>
    <p>Lyrenne is not affiliated with YouTube, Google or Alphabet.</p>
  </description>
  <launchable type="desktop-id">io.github.doctordefector.Lyrenne.desktop</launchable>
  <url type="homepage">https://doctordefector.github.io/Lyrenne/</url>
  <url type="bugtracker">https://github.com/Doctordefector/Lyrenne/issues</url>
  <url type="vcs-browser">https://github.com/Doctordefector/Lyrenne</url>
  <screenshots>
    <screenshot type="default">
      <caption>Your library, with the player and lyrics</caption>
      <image>https://doctordefector.github.io/Lyrenne/images/screenshot.jpg</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1">
